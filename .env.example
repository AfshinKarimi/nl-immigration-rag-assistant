# Copy to `.env` for local overrides (optional).
# Docker Compose already sets Ollama defaults for the app service.
#
# NEVER put real API keys or production passwords in git.

# Ollama — chat (llama3.2) and embeddings (nomic-embed-text).
# Compose talks to the ollama service. No cloud LLM API key is required.
SPRING_AI_OLLAMA_BASE_URL=http://ollama:11434
# For Ollama on the Mac host instead of the container:
# SPRING_AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Absolute URL other agents should POST JSON-RPC to (Agent Card "url")
A2A_PUBLIC_URL=http://localhost:8080/a2a

# Optional: Cohere Rerank (leave empty to fall back to hybrid-search order)
# NLRAG_RERANKER_API_KEY=

# Optional DB overrides when not using compose defaults (demo user/pass: nlrag)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nlrag
# SPRING_DATASOURCE_USERNAME=nlrag
# SPRING_DATASOURCE_PASSWORD=nlrag
